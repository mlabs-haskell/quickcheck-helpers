cabal-version: 3.0
name: logical-shrinking
version: 1.0.0
synopsis: Someday something will go here.
description: Someday something will go here.
license: MIT
author: Koz Ross
maintainer: koz@mlabs.city
category: Test
build-type: Simple
tested-with: ghc ==9.8.4

-- Common sections
common lang
  build-depends: base >=4.19.0.0
  ghc-options:
    -Wmissing-export-lists
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wredundant-constraints
    -Wmissing-deriving-strategies
    -Wredundant-bang-patterns

  default-language: Haskell2010

library
  import: lang
  exposed-modules: Test.Shrink
  build-depends: QuickCheck ^>=2.18.0.0
  hs-source-dirs: src

test-suite tests
  import: lang
  type: exitcode-stdio-1.0
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
    QuickCheck,
    logical-shrinking,
    tasty ^>=1.5.5,
    tasty-quickcheck,
